<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values-v31: the night qualifier outranks the API level, so
         dark-mode devices on Android 12+ need their own copy. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/night_sky</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/night_sky</item>
    </style>
</resources>
